{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Usage Lab",
  "version": "0.1.0",
  "identifier": "local.tokenusagelab.desktop",
  "build": {
    "frontendDist": "../dist", "devUrl": "http://127.0.0.1:18462",
    "beforeDevCommand": "pnpm run dev:renderer", "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [{"label": "main", "title": "Token Usage Lab", "width": 1180,
      "height": 820, "minWidth": 760, "minHeight": 560,
      "visible": true, "resizable": true, "center": true}],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {"active": false, "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]},
  "plugins": {}
}
